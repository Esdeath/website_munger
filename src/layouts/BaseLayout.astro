---
import "../styles/global.css";
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_KEYWORDS, SITE_TITLE } from "../content/site";
import { loadSiteCorpus } from "../lib/corpus";
import { buildOtherNavigation, buildSidebarSections } from "../lib/navigation";
import { canonicalUrl } from "../lib/seo";
import ThemePicker from "../components/ThemePicker.astro";
import FontSizePicker from "../components/FontSizePicker.astro";
import {
  ARTICLE_FONT_SIZE_DEFAULT,
  ARTICLE_FONT_SIZE_LEVELS,
  ARTICLE_FONT_SIZE_STORAGE_KEY
} from "../lib/font-size";
import { THEMES, THEME_STORAGE_KEY, themeMeta } from "../lib/theme";

interface Props {
  title: string;
  description?: string;
  shell?: "archive" | "reader";
  type?: "website" | "article";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const pageTitle = `${Astro.props.title} | ${SITE_TITLE}`;
const description = Astro.props.description ?? SITE_DESCRIPTION;
const shell = Astro.props.shell ?? "archive";
const pageType = Astro.props.type ?? "website";
const pageUrl = canonicalUrl(Astro.url.pathname);
const structuredData = Astro.props.structuredData
  ? Array.isArray(Astro.props.structuredData)
    ? Astro.props.structuredData
    : [Astro.props.structuredData]
  : [];
const structuredDataJson = structuredData.length === 1 ? JSON.stringify(structuredData[0]) : JSON.stringify(structuredData);
const siteCorpus = loadSiteCorpus();
const currentPath = decodeURIComponent(Astro.url.pathname);
const sidebarSections = buildSidebarSections(siteCorpus.articles, siteCorpus.sources, currentPath);
const otherNavigation = buildOtherNavigation(currentPath);
const otherGroupOpen = otherNavigation.some((item) => item.active);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="keywords" content={SITE_KEYWORDS.join(",")} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={themeMeta.light.color} />
    <script
      is:inline
      define:vars={{ THEMES, themeMeta, THEME_STORAGE_KEY }}
    >
      // @ts-ignore Astro injects define:vars before this inline bootstrap runs.
      var themeConfig = { options: THEMES, meta: themeMeta, storageKey: THEME_STORAGE_KEY };
      (function () {
        try {
          var stored = null;
          try {
            stored = localStorage.getItem(themeConfig.storageKey);
          } catch (e) {}
          var valid = themeConfig.options.indexOf(stored) !== -1;
          var theme = valid
            ? stored
            : window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          var root = document.documentElement;
          root.classList.remove("dark", "green");
          if (theme !== "light") root.classList.add(theme);
          root.style.colorScheme = theme === "dark" ? "dark" : "light";
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", themeConfig.meta[theme].color);
        } catch (e) {}
      })();
    </script>
    <script
      is:inline
      define:vars={{
        ARTICLE_FONT_SIZE_LEVELS,
        ARTICLE_FONT_SIZE_DEFAULT,
        ARTICLE_FONT_SIZE_STORAGE_KEY
      }}
    >
      // @ts-ignore Astro injects define:vars before this inline bootstrap runs.
      var fontSizeConfig = {
        levels: ARTICLE_FONT_SIZE_LEVELS,
        defaultPercent: ARTICLE_FONT_SIZE_DEFAULT,
        storageKey: ARTICLE_FONT_SIZE_STORAGE_KEY
      };
      (function () {
        try {
          var raw = null;
          try {
            raw = localStorage.getItem(fontSizeConfig.storageKey);
          } catch (e) {}
          var parsed = Number(raw);
          var percent = fontSizeConfig.levels.indexOf(parsed) !== -1 ? parsed : fontSizeConfig.defaultPercent;
          document.documentElement.style.setProperty("--article-font-scale", percent + "%");
        } catch (e) {}
      })();
    </script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType === "article" ? "article" : "website"} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {structuredData.length > 0 && <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>}
    <script is:inline>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?27ba6ea2e1b2f30c1acf9ed6977e1c8b";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`shell-${shell}`]}>
    <div class="app-shell">
      <input id="nav-drawer-state" class="drawer-state nav-drawer-state" type="checkbox" />
      <label class="drawer-scrim nav-drawer-scrim" for="nav-drawer-state" aria-hidden="true"></label>

      <header class="mobile-topbar" aria-label="移动端导航栏">
        <label class="topbar-button nav-drawer-toggle" for="nav-drawer-state" aria-label="打开导航">导航</label>
        <a class="mobile-topbar-brand" href="/">{SITE_TITLE}</a>
        {shell === "reader" ? (
          <label class="topbar-button reader-drawer-toggle" for="reader-drawer-state" aria-label="打开信息">信息</label>
        ) : (
          <span class="topbar-spacer" aria-hidden="true"></span>
        )}
      </header>

      <aside class="archive-sidebar" aria-label="知识库导航">
        <div class="sidebar-header">
          <a class="site-brand" href="/">{SITE_TITLE}</a>
          <div class="sidebar-tools">
            <FontSizePicker />
            <ThemePicker />
          </div>
        </div>
        <p class="sidebar-tagline">慢慢读，反复看，用原文校准判断。</p>
        <label class="search-box">
          <span class="sr-only">搜索</span>
          <input type="search" placeholder="搜索关键词、文章..." />
        </label>

        <nav class="sidebar-nav">
          {sidebarSections.map((section) => (
            <section class="sidebar-section">
              <h2>{section.title}</h2>
              <ul class="sidebar-tree">
                {section.groups.map((group) => (
                  <li>
                    <details open={group.open}>
                      <summary>
                        <span class="chevron" aria-hidden="true">›</span>
                        <span class="sidebar-group-label">{group.label}</span>
                        <span class="sidebar-count">· {group.count}</span>
                      </summary>
                      <ul class="sidebar-leaves">
                        {group.children.map((leaf) => (
                          <li>
                            <a class:list={[leaf.active && "is-active"]} href={leaf.href}>{leaf.label}</a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))}
                {section.title === "解读" && (
                  <li>
                    <details open={otherGroupOpen}>
                      <summary>
                        <span class="chevron" aria-hidden="true">›</span>
                        <span class="sidebar-group-label">其他</span>
                        <span class="sidebar-count">· {otherNavigation.length}</span>
                      </summary>
                      <ul class="sidebar-leaves">
                        {otherNavigation.map((item) => (
                          <li>
                            <a class:list={[item.active && "is-active"]} href={item.href}>{item.label}</a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                )}
              </ul>
            </section>
          ))}
        </nav>
      </aside>

      <main class="main-stage">
        <slot />
      </main>
    </div>
    <script>
      import { setupSidebarScrollPersistence } from "../lib/sidebar-scroll";

      const sidebar = document.querySelector<HTMLElement>(".archive-sidebar");
      if (sidebar) {
        setupSidebarScrollPersistence(sidebar);
      }
    </script>
  </body>
</html>
