---
import "../styles/global.css";
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_KEYWORDS, SITE_TITLE } from "../content/site";
import { loadArticles, loadOriginalSources } from "../lib/corpus";
import {
  buildSidebarSections,
  SEEKING_WISDOM_NAV,
  STOP_DOING_NAV,
  THINKING_GRID_NAV
} from "../lib/navigation";
import { absoluteUrl, canonicalUrl } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  shell?: "archive" | "reader";
  type?: "website" | "article";
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const pageTitle = Astro.props.title ? `${Astro.props.title} | ${SITE_TITLE}` : SITE_TITLE;
const description = Astro.props.description ?? SITE_DESCRIPTION;
const shell = Astro.props.shell ?? "archive";
const pageType = Astro.props.type ?? "website";
const robots = Astro.props.noindex ? "noindex,nofollow" : "index,follow";
const pageUrl = canonicalUrl(Astro.url.pathname);
const imageUrl = Astro.props.image ? absoluteUrl(Astro.props.image) : undefined;
const structuredData = Astro.props.structuredData
  ? Array.isArray(Astro.props.structuredData)
    ? Astro.props.structuredData
    : [Astro.props.structuredData]
  : [];
const structuredDataJson = structuredData.length === 1 ? JSON.stringify(structuredData[0]) : JSON.stringify(structuredData);
const sidebarSections = buildSidebarSections(loadArticles(), loadOriginalSources(), decodeURIComponent(Astro.url.pathname));
const stopDoingActive = decodeURIComponent(Astro.url.pathname).replace(/\/$/, "") === STOP_DOING_NAV.href.replace(/\/$/, "");
const thinkingGridActive = decodeURIComponent(Astro.url.pathname).replace(/\/$/, "").startsWith(
  THINKING_GRID_NAV.href.replace(/\/$/, "")
);
const seekingWisdomActive =
  decodeURIComponent(Astro.url.pathname).replace(/\/$/, "") === SEEKING_WISDOM_NAV.href.replace(/\/$/, "");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="keywords" content={SITE_KEYWORDS.join(",")} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType === "article" ? "article" : "website"} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {structuredData.length > 0 && <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>}
    <script is:inline>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?27ba6ea2e1b2f30c1acf9ed6977e1c8b";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`shell-${shell}`]}>
    <div class="app-shell">
      <input id="nav-drawer-state" class="drawer-state nav-drawer-state" type="checkbox" />
      <label class="drawer-scrim nav-drawer-scrim" for="nav-drawer-state" aria-hidden="true"></label>

      <header class="mobile-topbar" aria-label="移动端导航栏">
        <label class="topbar-button nav-drawer-toggle" for="nav-drawer-state" aria-label="打开导航">导航</label>
        <a class="mobile-topbar-brand" href="/">{SITE_TITLE}</a>
        {shell === "reader" ? (
          <label class="topbar-button reader-drawer-toggle" for="reader-drawer-state" aria-label="打开信息">信息</label>
        ) : (
          <span class="topbar-spacer" aria-hidden="true"></span>
        )}
      </header>

      <aside class="archive-sidebar" aria-label="知识库导航">
        <a class="site-brand" href="/">{SITE_TITLE}</a>
        <p class="sidebar-tagline">慢慢读，反复看，用原文校准判断。</p>
        <label class="search-box">
          <span class="sr-only">搜索</span>
          <input type="search" placeholder="搜索关键词、文章..." />
        </label>

        <nav class="sidebar-nav">
          <section class="sidebar-section">
            <ul class="sidebar-tree">
              <li>
                <a class:list={["sidebar-toplink", thinkingGridActive && "is-active"]} href={THINKING_GRID_NAV.href}>
                  {THINKING_GRID_NAV.label}
                </a>
              </li>
              <li>
                <a class:list={["sidebar-toplink", stopDoingActive && "is-active"]} href={STOP_DOING_NAV.href}>
                  {STOP_DOING_NAV.label}
                </a>
              </li>
              <li>
                <a
                  class:list={["sidebar-toplink", seekingWisdomActive && "is-active"]}
                  href={SEEKING_WISDOM_NAV.href}
                >
                  {SEEKING_WISDOM_NAV.label}
                </a>
              </li>
            </ul>
          </section>
          {sidebarSections.map((section) => (
            <section class="sidebar-section">
              <h2>{section.title}</h2>
              <ul class="sidebar-tree">
                {section.groups.map((group) => (
                  <li>
                    <details open={group.open}>
                      <summary>
                        <span class="chevron" aria-hidden="true">›</span>
                        <span class="sidebar-group-label">{group.label}</span>
                        <span class="sidebar-count">· {group.count}</span>
                      </summary>
                      <ul class="sidebar-leaves">
                        {group.children.map((leaf) => (
                          <li>
                            <a class:list={[leaf.active && "is-active"]} href={leaf.href}>{leaf.label}</a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </aside>

      <main class="main-stage">
        <slot />
      </main>
    </div>
    <script>
      import { setupSidebarScrollPersistence } from "../lib/sidebar-scroll";

      const sidebar = document.querySelector<HTMLElement>(".archive-sidebar");
      if (sidebar) {
        setupSidebarScrollPersistence(sidebar);
      }
    </script>
  </body>
</html>
