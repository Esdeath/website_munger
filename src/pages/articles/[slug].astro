---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadArticles, loadOriginalSources } from "../../lib/corpus";
import { renderMarkdownToHtml } from "../../lib/render";
import { articleKeywords, relatedArticles, sourcesForArticle } from "../../lib/relations";
import { buildArticleSchema, buildBreadcrumbSchema, canonicalUrl } from "../../lib/seo";

export function getStaticPaths() {
  return loadArticles().map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const allArticles = loadArticles();
const sources = loadOriginalSources();
const matchedSources = sourcesForArticle(article, sources);
const related = relatedArticles(article, allArticles);
const keywordLinks = allArticles.flatMap((item) =>
  articleKeywords(item).map((keyword) => ({
    keyword,
    href: `/articles/${item.slug}/`
  }))
);
const rendered = await renderMarkdownToHtml(article.body, {
  currentHref: `/articles/${article.slug}/`,
  keywordLinks
});
const structuredData = [
  buildArticleSchema({
    title: article.title,
    description: article.excerpt,
    pathname: `/articles/${article.slug}/`,
    keyword: article.keyword,
    category: article.category,
    citations:
      matchedSources.length > 0
        ? matchedSources.map((source) => canonicalUrl(`/sources/${source.slug}/`))
        : article.sources,
    datePublished: article.date
  }),
  buildBreadcrumbSchema([
    { name: "首页", pathname: "/" },
    { name: "解释文章", pathname: "/articles/" },
    { name: article.title, pathname: `/articles/${article.slug}/` }
  ])
];
---

<BaseLayout title={article.title} description={article.excerpt} shell="reader" type="article" structuredData={structuredData}>
  <article class="reader-layout">
    <div class="reader-content">
      <header class="reader-header">
        <h1>{article.title}</h1>
        <p>{article.category}</p>
        <p class="reader-intro">{article.excerpt}</p>
      </header>
      <div class="article-body" set:html={rendered} />
    </div>

    <input id="reader-drawer-state" class="drawer-state reader-drawer-state" type="checkbox" />
    <label class="drawer-scrim reader-drawer-scrim" for="reader-drawer-state" aria-hidden="true"></label>

    <aside class="reader-aside">
      <section class="info-panel">
        <h2>文章信息</h2>
        <p>{article.category} · {article.quoteCount} 处引用</p>
        <p>{article.sources.length} 个原文来源</p>
      </section>

      <section class="info-panel">
        <h2>本篇目录（{article.headings.length}）</h2>
        <ul class="link-list">
          {article.headings.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ul>
      </section>

      <section class="info-panel">
        <h2>来源追溯</h2>
        <ul class="link-list">
          {matchedSources.map((source) => (
            <li><a href={`/sources/${source.slug}/`}>{source.title}</a></li>
          ))}
          {matchedSources.length === 0 && article.sources.map((sourceLabel) => <li>{sourceLabel}</li>)}
        </ul>
      </section>

      <section class="info-panel">
        <h2>相关主题</h2>
        <ul class="link-list">
          {related.map((item) => (
            <li><a href={`/articles/${item.slug}/`}>{item.keyword} →</a></li>
          ))}
        </ul>
      </section>
    </aside>
  </article>
</BaseLayout>
