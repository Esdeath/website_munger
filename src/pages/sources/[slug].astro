---
import ArticleShare from "../../components/ArticleShare.astro";
import ReaderPage from "../../components/ReaderPage.astro";
import { loadSiteCorpus } from "../../lib/corpus";
import { renderMarkdownToHtml } from "../../lib/render";
import {
  buildSourceArticleMap,
  keywordLinksForArticles,
  mentionedArticlesForSource,
  sameYearSources
} from "../../lib/relations";
import { buildBreadcrumbSchema, buildCreativeWorkSchema, canonicalUrl } from "../../lib/seo";
import { sourceTypeLabel } from "../../lib/source-types";

export function getStaticPaths() {
  return loadSiteCorpus().sources
    .filter((source) => !source.standalone)
    .map((source) => ({ params: { slug: source.slug }, props: { source } }));
}

const { source } = Astro.props;
const { articles, sources: allSources } = loadSiteCorpus();
const sourceArticleMap = buildSourceArticleMap(articles, allSources);
const citedBy = sourceArticleMap.get(source.slug) ?? [];
const mentionedArticles = mentionedArticlesForSource(source, articles);
const sameYear = sameYearSources(source, allSources);
const bodyWithoutDuplicateTitle = source.body.replace(new RegExp(`^#\\s+${source.title.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\s*\\n+`), "");
const keywordLinks = keywordLinksForArticles(articles);
const rendered = await renderMarkdownToHtml(bodyWithoutDuplicateTitle, { keywordLinks });
const sourceLabel = sourceTypeLabel(source);
const structuredData = [
  buildCreativeWorkSchema({
    title: source.title,
    description: source.excerpt,
    pathname: `/sources/${source.slug}/`,
    sourceTypeLabel: sourceLabel,
    year: source.year
  }),
  buildBreadcrumbSchema([
    { name: "首页", pathname: "/" },
    { name: "原文资料", pathname: "/sources/" },
    { name: source.title, pathname: `/sources/${source.slug}/` }
  ])
];
---

<ReaderPage title={source.title} description={source.excerpt} structuredData={structuredData} html={rendered}>
  <Fragment slot="header">
    <h1>{source.title}</h1>
    <p>{sourceLabel}</p>
  </Fragment>

  <ArticleShare
    slot="actions"
    title={source.title}
    url={canonicalUrl(`/sources/${source.slug}/`)}
    markdown={bodyWithoutDuplicateTitle}
    html={rendered}
  />

  <Fragment slot="aside">
    <section class="info-panel">
      <h2>原文信息</h2>
      <p>{sourceLabel} · 第 {source.year} 年</p>
      <p>{citedBy.length} 篇解读引用</p>
    </section>

    <section class="info-panel">
      <h2>本篇目录（{source.headings.length}）</h2>
      <ul class="link-list">
        {source.headings.map((heading) => (
          <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ul>
    </section>

    <section class="info-panel">
      <h2>本篇涉及的关键词（{mentionedArticles.length}）</h2>
      <ul class="keyword-list">
        {mentionedArticles.map((article) => (
          <li><a href={`/articles/${article.slug}/`}>{article.keyword}</a></li>
        ))}
      </ul>
    </section>

    <section class="info-panel">
      <h2>同类原文</h2>
      <ul class="link-list">
        {sameYear.map((item) => (
          <li><a href={`/sources/${item.slug}/`}>{item.title} →</a></li>
        ))}
      </ul>
    </section>
  </Fragment>
</ReaderPage>
