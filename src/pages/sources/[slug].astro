---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadArticles, loadOriginalSources } from "../../lib/corpus";
import { renderMarkdownToHtml } from "../../lib/render";
import { buildSourceArticleMap, sameYearSources } from "../../lib/relations";
import { buildBreadcrumbSchema, buildCreativeWorkSchema, sourceTypeLabel } from "../../lib/seo";

export function getStaticPaths() {
  return loadOriginalSources().map((source) => ({ params: { slug: source.slug }, props: { source } }));
}

const { source } = Astro.props;
const articles = loadArticles();
const allSources = loadOriginalSources();
const sourceArticleMap = buildSourceArticleMap(articles, allSources);
const citedBy = sourceArticleMap.get(source.slug) ?? [];
const sameYear = sameYearSources(source, allSources);
const bodyWithoutDuplicateTitle = source.body.replace(new RegExp(`^#\\s+${source.title.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\s*\\n+`), "");
const keywordLinks = articles.map((article) => ({
  keyword: article.keyword,
  href: `/articles/${article.slug}/`
}));
const rendered = await renderMarkdownToHtml(bodyWithoutDuplicateTitle, { keywordLinks });
const sourceLabel = sourceTypeLabel(source);
const structuredData = [
  buildCreativeWorkSchema({
    title: source.title,
    description: source.excerpt,
    pathname: `/sources/${source.slug}/`,
    sourceTypeLabel: sourceLabel,
    year: source.year
  }),
  buildBreadcrumbSchema([
    { name: "首页", pathname: "/" },
    { name: "原文资料", pathname: "/sources/" },
    { name: source.title, pathname: `/sources/${source.slug}/` }
  ])
];
---

<BaseLayout title={source.title} description={source.excerpt} shell="reader" structuredData={structuredData}>
  <article class="reader-layout">
    <div class="reader-content">
      <header class="reader-header">
        <h1>{source.title}</h1>
        <p>{sourceLabel}</p>
      </header>
      <div class="article-body" set:html={rendered} />
    </div>

    <input id="reader-drawer-state" class="drawer-state reader-drawer-state" type="checkbox" />
    <label class="drawer-scrim reader-drawer-scrim" for="reader-drawer-state" aria-hidden="true"></label>

    <aside class="reader-aside">
      <section class="info-panel">
        <h2>原文信息</h2>
        <p>{sourceLabel} · 第 {source.year} 年</p>
        <p>{citedBy.length} 篇解读引用</p>
      </section>

      <section class="info-panel">
        <h2>本篇目录（{source.headings.length}）</h2>
        <ul class="link-list">
          {source.headings.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ul>
      </section>

      <section class="info-panel">
        <h2>本篇涉及的关键词（{citedBy.length}）</h2>
        <ul class="keyword-list">
          {citedBy.map((article) => (
            <li><a href={`/articles/${article.slug}/`}>{article.keyword}</a></li>
          ))}
        </ul>
      </section>

      <section class="info-panel">
        <h2>同类原文</h2>
        <ul class="link-list">
          {sameYear.map((item) => (
            <li><a href={`/sources/${item.slug}/`}>{item.title} →</a></li>
          ))}
        </ul>
      </section>
    </aside>
  </article>
</BaseLayout>
