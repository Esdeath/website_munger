---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadOriginalSources } from "../../lib/corpus";
import { buildCollectionPageSchema, canonicalUrl } from "../../lib/seo";

const sources = loadOriginalSources().sort(
  (a, b) => a.year.localeCompare(b.year) || a.title.localeCompare(b.title, "zh-Hans-CN")
);
const sourceGroups = [
  {
    id: "shareholder",
    title: "股东会与股东信",
    sources: sources.filter((source) => source.type === "shareholder")
  },
  {
    id: "speech",
    title: "演讲与访谈",
    sources: sources.filter((source) => source.type === "speech")
  }
];
const structuredData = buildCollectionPageSchema({
  title: "原文资料",
  description: "查理·芒格股东会、股东信、演讲、访谈与声明原文资料索引。",
  pathname: "/sources/",
  itemUrls: sources.map((source) => canonicalUrl(`/sources/${source.slug}/`))
});
---

<BaseLayout title="原文资料" description="查理·芒格股东会、股东信、演讲、访谈与声明原文资料索引。" structuredData={structuredData}>
  <section class="page">
    <p class="eyebrow">原文语境层</p>
    <h1 class="hero-title">股东会、演讲、访谈与声明。</h1>
    <p class="hero-copy">原文优先，所有解读都应能回到这里。</p>
    {sourceGroups.map((group) => (
      <section class="archive-section" id={group.id}>
        <p class="section-kicker">{group.title} · {group.sources.length} 篇</p>
        <div class="grid">
          {group.sources.map((source) => (
            <article class="card">
              <h2><a href={`/sources/${source.slug}/`}>{source.title}</a></h2>
              <p>{source.excerpt}</p>
              <p class="meta">{source.year} / {group.title}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
