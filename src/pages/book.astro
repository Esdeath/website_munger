<style>
  .offer {
    --o-bg: var(--bg);
    --o-card: var(--paper);
    --o-ink: var(--ink);
    --o-muted: var(--muted);
    --o-line: var(--line);
    --o-accent: var(--orange);
    --o-on: #ffffff;
    --o-soft: var(--orange-soft);
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 64px) clamp(18px, 5vw, 28px) 96px;
    color: var(--o-ink);
  }
  .offer * { box-sizing: border-box; }
  .offer .kicker {
    margin: 0 0 14px;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 12px;
    letter-spacing: .18em;
    color: var(--o-accent);
  }
  .offer h1, .offer h2, .offer h3 { font-family: var(--serif, Georgia, "Noto Serif SC", serif); font-weight: 600; color: var(--o-ink); }
  .offer b, .offer strong { color: var(--o-ink); }
  .offer h1 {
    margin: 0 0 20px;
    font-size: clamp(38px, 6.4vw, 64px);
    line-height: 1.14;
    letter-spacing: -.01em;
    text-wrap: balance;
  }
  .lede {
    max-width: 44em;
    margin: 0 0 26px;
    font-size: 16.5px;
    line-height: 1.85;
    color: var(--o-muted);
  }
  .lede strong { color: var(--o-ink); font-weight: 600; }
  .hero { display: block; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 34px; }
  .hero-includes {
    margin: 6px 0 34px; padding: 18px 20px; border: 1px solid var(--o-line); border-radius: 12px;
    background: var(--o-card);
  }
  .inc-title { margin: 0 0 10px; font-family: var(--sans, system-ui, sans-serif); font-size: 11.5px; letter-spacing: .14em; color: var(--o-accent); }
  .hero-includes ul { margin: 0; padding: 0; list-style: none; }
  .hero-includes li { display: flex; justify-content: space-between; gap: 14px; padding: 6px 0; font-size: 13.5px; border-bottom: 1px dashed color-mix(in srgb, var(--o-line) 60%, transparent); }
  .hero-includes li:last-child { border-bottom: none; }
