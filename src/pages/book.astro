---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_AUTHOR, SITE_TITLE } from "../content/site";
import { canonicalUrl } from "../lib/seo";

/*
  价投书房 · 电子书会员落地页（四站共用版式与文案，仅 tokens / 二维码 / 试读链接不同）。
  书目与页数取自各站最新成书：20 本、21,569 页。
  改动价格、权益或二维码时，四站要一起改。
*/
const url = canonicalUrl('/book/');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: '价投书房 · 四套知识库电子书',
  description: '加入知识星球「滚雪球的小部落」，¥199/年拿全巴菲特、芒格、段永平、帕伯莱四套知识库的 EPUB 与 PDF，共 20 本、21,569 页。',
  brand: { '@type': 'Organization', name: SITE_AUTHOR },
  offers: { '@type': 'Offer', url, price: 199, priceCurrency: 'CNY', availability: 'https://schema.org/InStock' },
};
---

<BaseLayout
  title="价投书房 · 四套知识库电子书"
  seoTitle="价投书房 · ¥199/年拿走四套知识库电子书 | {SITE_TITLE}"
  description="加入知识星球「滚雪球的小部落」，¥199/年拿全巴菲特、芒格、段永平、帕伯莱四套知识库的 EPUB 与 PDF，共 20 本、21,569 页。"
  structuredData={structuredData}
  type="website"
>

  <article class="offer">
    <header class="hero">
      <div class="hero-copy">
      <p class="kicker">价投书房 · 四套知识库 · ¥199 / 年</p>
      <h1>把四套知识库<br />装进口袋</h1>
      <p class="lede">
        段永平原典、巴菲特知识库、芒格知识库、帕伯莱知识库，一次打包成
        20 本 <strong>EPUB + PDF</strong>，共 <strong>21,569 页</strong>。
        年费 199 元，下载后永久保存；会员期内新增与改版，免费同步。
      </p>
