---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TOPICS } from "../content/site";
import { loadArticles, loadOriginalSources } from "../lib/corpus";
import { buildArchiveCards } from "../lib/navigation";

const articles = loadArticles();
const sources = loadOriginalSources();
const archiveCards = buildArchiveCards(TOPICS, articles);
const originalCards = [
  {
    mark: "会",
    title: "股东会与股东信",
    description: "历年股东会、股东信与问答记录",
    href: "/sources/#shareholder",
    count: sources.filter((source) => source.type === "shareholder").length
  },
  {
    mark: "访",
    title: "演讲与访谈",
    description: "公开演讲、访谈、文章与声明",
    href: "/sources/#speech",
    count: sources.filter((source) => source.type === "speech").length
  }
];
---

<BaseLayout title="首页">
  <section class="overview-page">
    <header class="overview-hero">
      <h1>芒格总纲</h1>
      <div class="hero-rule" aria-hidden="true"></div>
      <p class="hero-laws">第一条规则：永远不要愚蠢</p>
      <p class="hero-laws">第二条规则：永远记住第一条</p>
      <a class="source-card author-card" href="/sources/">
        <span>
          <strong>资料：本仓库原文语料</strong>
          <small>articles / shareholders / speech</small>
        </span>
        <span class="card-arrow">›</span>
      </a>
    </header>

    <section class="archive-section">
      <p class="section-kicker">原文 · {sources.length} 篇</p>
      <p class="section-copy">先原文，后观点；先证据，后文章。一切回到芒格自己的话。</p>
      <div class="archive-grid">
        {originalCards.map((card) => (
          <a class="archive-card" href={card.href}>
            <span class="archive-mark">{card.mark}</span>
            <span class="archive-card-body">
              <strong>{card.title}</strong>
              <small>{card.description}</small>
            </span>
            <span class="archive-count">{card.count} 篇</span>
          </a>
        ))}
      </div>
    </section>

    <section class="archive-section">
      <p class="section-kicker">解读 · {archiveCards.length} 个分类</p>
      <p class="section-copy">围绕主题整理的解释文章，每条都标注原文出处。</p>
      <div class="archive-grid">
        {archiveCards.map((card) => (
          <a class="archive-card" href={card.href}>
            <span class="archive-mark">{card.mark}</span>
            <span class="archive-card-body">
              <strong>{card.title}</strong>
              <small>{card.description}</small>
            </span>
            <span class="archive-count">{card.count} 篇</span>
          </a>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
