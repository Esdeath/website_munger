---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TOPICS } from "../content/site";
import { loadArticles, loadOriginalSources } from "../lib/corpus";
import { buildArchiveCards } from "../lib/navigation";
import { buildCollectionPageSchema, buildWebsiteSchema, canonicalUrl } from "../lib/seo";

const articles = loadArticles();
const sources = loadOriginalSources();
const archiveCards = buildArchiveCards(TOPICS, articles);
const originalCards = [
  {
    mark: "会",
    title: "股东会与股东信",
    description: "历年股东会、股东信与问答记录",
    href: "/sources/#shareholder",
    count: sources.filter((source) => source.type === "shareholder").length
  },
  {
    mark: "访",
    title: "演讲与访谈",
    description: "公开演讲、访谈、文章与声明",
    href: "/sources/#speech",
    count: sources.filter((source) => source.type === "speech").length
  }
];
const structuredData = [
  buildWebsiteSchema(),
  buildCollectionPageSchema({
    title: "芒格总纲",
    description: "查理·芒格思想知识库首页，按原文资料和解释文章组织阅读入口。",
    pathname: "/",
    itemUrls: [
      canonicalUrl("/sources/"),
      canonicalUrl("/articles/"),
      ...TOPICS.map((topic) => canonicalUrl(`/topics/${topic.slug}/`))
    ]
  })
];
---

<BaseLayout title="首页" structuredData={structuredData}>
  <section class="overview-page">
    <header class="overview-hero">
      <div class="hero-rule hero-rule-top" aria-hidden="true"></div>
      <h1>芒格总纲</h1>
      <div class="hero-rule hero-rule-bottom" aria-hidden="true"></div>
      <p class="hero-laws">如果我知道我会死在哪里，我就永远不去那里</p>
      <a class="source-card author-card" href="https://xueqiu.com/u/lovelive" target="_blank" rel="noopener noreferrer">
        <span>
          <strong>作者:滚雪球的Star</strong>
        </span>
        <span class="card-arrow">›</span>
      </a>
    </header>

    <section class="archive-section">
      <p class="section-kicker">原文 · {sources.length} 篇</p>
      <p class="section-copy">先原文，后观点；先证据，后文章。一切回到芒格自己的话。</p>
      <div class="archive-grid">
        {originalCards.map((card) => (
          <a class="archive-card" href={card.href}>
            <span class="archive-mark">{card.mark}</span>
            <span class="archive-card-body">
              <strong>{card.title}</strong>
              <small>{card.description}</small>
            </span>
            <span class="archive-count">{card.count} 篇</span>
          </a>
        ))}
      </div>
    </section>

    <section class="archive-section">
      <p class="section-kicker">解读 · {archiveCards.length} 个分类</p>
      <p class="section-copy">围绕主题整理的解释文章，每条都标注原文出处。</p>
      <div class="archive-grid">
        {archiveCards.map((card) => (
          <a class="archive-card" href={card.href}>
            <span class="archive-mark">{card.mark}</span>
            <span class="archive-card-body">
              <strong>{card.title}</strong>
              <small>{card.description}</small>
            </span>
            <span class="archive-count">{card.count} 篇</span>
          </a>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
