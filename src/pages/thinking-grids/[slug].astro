---
import ReaderPage from "../../components/ReaderPage.astro";
import { renderMarkdownToHtml } from "../../lib/render";
import {
  bodyWithoutExcerpt,
  loadThinkingGridSnapshot,
  resolveThinkingGridMarkdownLink,
  thinkingGridHref,
  type ThinkingGridDocument
} from "../../lib/thinking-grid";
import { buildBreadcrumbSchema, buildCreativeWorkSchema } from "../../lib/seo";

export function getStaticPaths() {
  return loadThinkingGridSnapshot().models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props as { model: ThinkingGridDocument };
const snapshot = loadThinkingGridSnapshot();
const rendered = await renderMarkdownToHtml(bodyWithoutExcerpt(model.body), {
  relativeLinkResolver: (url) => resolveThinkingGridMarkdownLink(url, snapshot),
  wikiLinks: true
});
const pathname = thinkingGridHref(model.slug);
const structuredData = [
  buildCreativeWorkSchema({
    title: model.title,
    description: model.excerpt,
    pathname,
    sourceTypeLabel: "思维格栅",
    year: ""
  }),
  buildBreadcrumbSchema([
    { name: "首页", pathname: "/" },
    { name: "思维格栅", pathname: "/thinking-grids/" },
    { name: model.title, pathname }
  ])
];
---

<ReaderPage
  title={model.title}
  description={model.excerpt}
  type="article"
  structuredData={structuredData}
  html={rendered}
>
  <Fragment slot="header">
    <p>思维格栅</p>
    <h1>{model.title}</h1>
    <p class="reader-intro">{model.excerpt}</p>
  </Fragment>

  <Fragment slot="aside">
    <section class="info-panel">
      <h2>模型信息</h2>
      <p>思维格栅 · 模型文章</p>
    </section>

    <section class="info-panel">
      <h2>本篇目录（{model.headings.length}）</h2>
      <ul class="link-list">
        {model.headings.map((heading) => (
          <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ul>
    </section>
  </Fragment>
</ReaderPage>
