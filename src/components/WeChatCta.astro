---
// 「添加微信，可以获取更多资料」入口。四站共用同一个微信号与二维码。
// variant="float"：全站右下角悬浮，点开是二维码面板（本次访问可隐藏）。
// variant="inline"：文章末尾的二维码卡片。
interface Props {
  variant?: 'float' | 'inline';
}

const { variant = 'float' } = Astro.props;
const wechatId = 'livemisaka';
const qrSrc = '/images/wechat-qr.png';
---

{variant === 'float' ? (
  <aside class="wx-float" data-wx-float aria-label="添加作者微信">
    <button
      class="wx-trigger"
      type="button"
      data-wx-trigger
      aria-expanded="false"
      aria-controls="wx-float-panel"
    >
      <svg class="wx-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M9.4 4C5.3 4 2 6.8 2 10.2c0 1.9 1 3.6 2.7 4.8l-.7 2.1 2.4-1.2c.9.3 1.9.4 3 .4h.6a5.6 5.6 0 0 1-.2-1.5c0-3.2 3.1-5.8 6.9-5.8h.9C17 6.5 13.6 4 9.4 4Zm-2.5 3.2a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Zm5 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z"></path>
        <path d="M22 14.8c0-2.8-2.7-5-6-5s-6 2.2-6 5 2.7 5 6 5c.7 0 1.4-.1 2-.3l2 1-.6-1.7c1.6-1 2.6-2.4 2.6-4Zm-7.9-1.6a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6Zm3.8 0a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6Z"></path>
      </svg>
      <span class="wx-trigger-long">添加微信，可以获取更多资料</span>
      <span class="wx-trigger-short">添加微信</span>
    </button>

    <div class="wx-panel" id="wx-float-panel" data-wx-panel hidden>
      <div class="wx-panel-head">
        <strong>添加微信，可以获取更多资料</strong>
        <button class="wx-close" type="button" data-wx-close aria-label="收起二维码">×</button>
      </div>
      <img
        class="wx-qr"
        src={qrSrc}
        alt="作者微信二维码：livemisaka"
        width="148"
        height="148"
        loading="lazy"
      />
      <p class="wx-id">{wechatId}</p>
      <button class="wx-copy-btn" type="button" data-wx-copy={wechatId}>复制微信号</button>
      <p class="wx-hint">微信扫码添加，备注「资料」</p>
      <button class="wx-hide" type="button" data-wx-hide>本次访问不再提示</button>
    </div>
  </aside>
) : (
  <aside class="wx-inline" aria-label="添加作者微信">
    <img
      class="wx-qr"
      src={qrSrc}
      alt="作者微信二维码：livemisaka"
      width="104"
      height="104"
      loading="lazy"
    />
    <div class="wx-inline-body">
      <p class="wx-inline-title">添加微信，可以获取更多资料</p>
      <p class="wx-inline-sub">微信号 <strong>{wechatId}</strong> · 扫码或搜索添加，备注「资料」</p>
      <button class="wx-copy-btn" type="button" data-wx-copy={wechatId}>复制微信号</button>
    </div>
  </aside>
)}

<script>
  const STORAGE_KEY = 'wx-cta-hidden';

  // 复制微信号：优先用 Clipboard API，非安全上下文回退到临时 textarea。
  async function copyWechat(button: HTMLButtonElement) {
    const text = button.getAttribute('data-wx-copy') || '';
    if (!text) return;
    let ok = false;
    try {
      await navigator.clipboard.writeText(text);
      ok = true;
    } catch {
      const input = document.createElement('textarea');
      input.value = text;
      input.setAttribute('readonly', '');
      input.style.position = 'fixed';
      input.style.top = '-1000px';
      document.body.appendChild(input);
      input.select();
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      document.body.removeChild(input);
    }
    if (!ok) return;
    const original = button.textContent;
    button.textContent = '已复制';
    button.classList.add('is-copied');
    window.setTimeout(() => {
      button.textContent = original;
      button.classList.remove('is-copied');
    }, 1600);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-wx-copy]').forEach((button) => {
    if (button.dataset.wxReady === '1') return;
    button.dataset.wxReady = '1';
    button.addEventListener('click', () => copyWechat(button));
  });

  document.querySelectorAll<HTMLElement>('[data-wx-float]').forEach((root) => {
    if (root.dataset.wxReady === '1') return;
    root.dataset.wxReady = '1';

    const trigger = root.querySelector<HTMLButtonElement>('[data-wx-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-wx-panel]');
    const close = root.querySelector<HTMLButtonElement>('[data-wx-close]');
    const hide = root.querySelector<HTMLButtonElement>('[data-wx-hide]');
    if (!trigger || !panel) return;

    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    try {
      if (sessionStorage.getItem(STORAGE_KEY) === '1') root.hidden = true;
    } catch {
      /* 隐私模式下 sessionStorage 不可用，照常显示 */
    }

    trigger.addEventListener('click', () => setOpen(panel.hidden));
    close?.addEventListener('click', () => {
      setOpen(false);
      trigger.focus();
    });
    hide?.addEventListener('click', () => {
      setOpen(false);
      root.hidden = true;
      try {
        sessionStorage.setItem(STORAGE_KEY, '1');
      } catch {
        /* 存不了就只隐藏这一次 */
      }
    });

    document.addEventListener('click', (event) => {
      if (panel.hidden) return;
      const target = event.target;
      if (target instanceof Node && !root.contains(target)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });
  });
</script>

<style>
  .wx-float {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 25;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  /* hidden 属性要压过 display:flex，否则“本次访问不再提示”关不掉 */
  .wx-float[hidden] {
    display: none;
  }

  .wx-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 15px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font: 600 13px/1.3 var(--sans);
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .wx-trigger:hover {
    border-color: var(--orange);
    transform: translateY(-1px);
  }

  .wx-icon {
    flex: none;
    width: 17px;
    height: 17px;
    color: var(--orange);
  }

  .wx-trigger-short {
    display: none;
  }

  .wx-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    width: 236px;
    padding: 14px 16px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    box-shadow: 0 18px 48px rgb(24 20 16 / 0.22);
    text-align: center;
  }

  .wx-panel-head {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 10px;
    text-align: left;
  }

  .wx-panel-head strong {
    flex: 1;
    color: var(--ink);
    font: 700 13px/1.5 var(--sans);
  }

  .wx-close {
    flex: none;
    width: 22px;
    height: 22px;
    margin: -2px -4px 0 0;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }

  .wx-close:hover {
    background: var(--orange-soft);
    color: var(--ink);
  }

  .wx-qr {
    display: block;
    margin: 0 auto;
    padding: 4px;
    background: #fff;
    border-radius: 4px;
    image-rendering: pixelated;
  }

  .wx-panel .wx-qr {
    width: 148px;
    height: 148px;
  }

  .wx-id {
    margin: 8px 0 0;
    color: var(--orange);
    font: 700 15px/1.4 var(--sans);
    letter-spacing: 0.02em;
    user-select: all;
  }

  .wx-copy-btn {
    margin-top: 8px;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: transparent;
    color: var(--muted);
    font: 500 12px/1.4 var(--sans);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .wx-copy-btn:hover,
  .wx-copy-btn.is-copied {
    border-color: var(--orange);
    background: var(--orange-soft);
    color: var(--orange);
  }

  .wx-hint {
    margin: 8px 0 0;
    color: var(--muted);
    font: 400 11px/1.6 var(--sans);
  }

  .wx-hide {
    margin-top: 2px;
    padding: 2px 4px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 400 11px/1.6 var(--sans);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    opacity: 0.75;
  }

  .wx-hide:hover {
    color: var(--ink);
    opacity: 1;
  }

  .wx-inline {
    display: flex;
    align-items: center;
    gap: 18px;
    max-width: 600px;
    margin: 40px 0 8px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
  }

  .wx-inline .wx-qr {
    flex: none;
    width: 104px;
    height: 104px;
  }

  .wx-inline-body {
    min-width: 0;
  }

  .wx-inline-title {
    margin: 0;
    color: var(--ink);
    font: 700 15px/1.6 var(--sans);
  }

  .wx-inline-sub {
    margin: 4px 0 0;
    color: var(--muted);
    font: 400 12px/1.7 var(--sans);
  }

  .wx-inline-sub strong {
    color: var(--orange);
    font-weight: 700;
    user-select: all;
  }

  @media (max-width: 680px) {
    .wx-float {
      right: max(12px, env(safe-area-inset-right));
      bottom: max(14px, env(safe-area-inset-bottom));
    }

    .wx-trigger {
      padding: 10px 13px;
    }

    .wx-trigger-long {
      display: none;
    }

    .wx-trigger-short {
      display: inline;
    }

    .wx-inline {
      gap: 13px;
      padding: 13px 14px;
    }

    .wx-inline .wx-qr {
      width: 84px;
      height: 84px;
    }

    .wx-inline-title {
      font-size: 14px;
    }
  }
</style>
