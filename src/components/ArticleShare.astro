---
import { Share2 } from "@lucide/astro";
import { SITE_TITLE } from "../content/site";
import { buildMarkdownSharePayload } from "../lib/article-share";

interface Props {
  title: string;
  url: string;
  markdown: string;
}

const { title, url, markdown } = Astro.props;
const shareMarkdown = buildMarkdownSharePayload({ siteTitle: SITE_TITLE, title, url, markdown });
const serializedMarkdown = JSON.stringify(shareMarkdown).replaceAll("<", "\\u003c");
const statusId = "article-share-status";
---

<div class="article-share" data-article-share data-share-title={title} data-share-url={url} data-share-site-title={SITE_TITLE}>
  <button class="article-share-button" type="button" data-share-button aria-describedby={statusId}>
    <Share2 size={16} stroke-width={2} aria-hidden="true" />
    <span data-share-label>分享</span>
  </button>
  <span class="article-share-status" id={statusId} role="status" aria-live="polite"></span>
  <script is:inline type="application/json" data-share-markdown set:html={serializedMarkdown}></script>
</div>

<script>
  import { buildHtmlSharePayload } from "../lib/article-share";

  interface SharePayload {
    markdown: string;
    html: string;
  }

  async function writeSharePayload(payload: SharePayload): Promise<void> {
    if (!navigator.clipboard) {
      throw new Error("Clipboard API unavailable");
    }

    if (typeof ClipboardItem !== "undefined" && typeof navigator.clipboard.write === "function") {
      try {
        const item = new ClipboardItem({
          "text/html": new Blob([payload.html], { type: "text/html" }),
          "text/plain": new Blob([payload.markdown], { type: "text/plain" })
        });
        await navigator.clipboard.write([item]);
        return;
      } catch {
        // Some browsers expose rich clipboard APIs but reject specific MIME types.
      }
    }

    if (typeof navigator.clipboard.writeText === "function") {
      await navigator.clipboard.writeText(payload.markdown);
      return;
    }

    throw new Error("Clipboard write unavailable");
  }

  document.querySelectorAll<HTMLElement>("[data-article-share]").forEach((root) => {
    if (root.dataset.shareInitialized === "true") {
      return;
    }

    const button = root.querySelector<HTMLButtonElement>("[data-share-button]");
    const label = root.querySelector<HTMLElement>("[data-share-label]");
    const status = root.querySelector<HTMLElement>("[role='status']");
    const markdownElement = root.querySelector<HTMLScriptElement>("[data-share-markdown]");
    const markdownJson = markdownElement?.textContent;
    const articleBody = root.closest(".reader-content")?.querySelector<HTMLElement>(".article-body");
    if (!button || !label || !status || !markdownJson || !articleBody) {
      return;
    }

    let resetTimer: number | undefined;
    root.dataset.shareInitialized = "true";

    button.addEventListener("click", async () => {
      window.clearTimeout(resetTimer);
      button.disabled = true;
      label.textContent = "复制中";
      status.textContent = "";

      try {
        const payload: SharePayload = {
          markdown: JSON.parse(markdownJson) as string,
          html: buildHtmlSharePayload({
            siteTitle: root.dataset.shareSiteTitle ?? "",
            title: root.dataset.shareTitle ?? "",
            url: root.dataset.shareUrl ?? "",
            html: articleBody.innerHTML
          })
        };
        await writeSharePayload(payload);
        label.textContent = "已复制";
        status.textContent = "文章和格式已复制";
        resetTimer = window.setTimeout(() => {
          label.textContent = "分享";
          status.textContent = "";
        }, 2000);
      } catch {
        label.textContent = "分享";
        status.textContent = "复制失败，请重试";
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
